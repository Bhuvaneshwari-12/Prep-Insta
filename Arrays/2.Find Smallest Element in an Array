import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int[] arr = new int[5];

        // Input
        for(int i = 0; i < arr.length; i++){
            arr[i] = sc.nextInt();
        }

        // Print array
        for(int i = 0; i < arr.length; i++){
            System.out.println(arr[i]);
        }

        // Find minimum
        int min = arr[0];

        for(int i = 1; i < arr.length; i++){
            if(min > arr[i]){
                min = arr[i];
            }
        }

        System.out.println("Minimum number is: " + min);

        sc.close();
    }
}
