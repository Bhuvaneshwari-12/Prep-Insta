import java.util.*;
public class Main{
    public static void main(String[] args){
        
        Scanner sc = new Scanner(System.in);
        int num = sc.nextInt();
        String str = Integer.toString(num);
        String rev =new StringBuilder(str).reverse().toString();
        if(str.equals(rev)){
            System.out.print("palindrome");
        }
        else{
            System.out.print("Not");
        }
        
    }
}
