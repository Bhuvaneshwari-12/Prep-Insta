import java.util.*; 
public class Main{ 
    public static void main(String[] args){ 
        Scanner sc = new Scanner(System.in); 
        int num = sc.nextInt(); 
        if(num == 0){ 
            System.out.print("Zero"); 
        } 
        else if(num > 0){ 
            System.out.print("Positive"); 
        } 
        else{ 
            System.out.print("Negative"); 
        }
    } 
}


