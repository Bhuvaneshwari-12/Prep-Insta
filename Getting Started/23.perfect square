import java.util.*;
public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int num = sc.nextInt();
        boolean flag = false;

        for(int i = 1; i * i <= num; i++){
            if(i * i == num){
                flag = true;
                break;
            }
        }

        if(flag)
            System.out.println("Perfect square");
        else
            System.out.println("Not");
    }
}
