import java.util.*;
public class Main{
    public static void main(String[] args){
        int sum =0;
        Scanner sc = new Scanner(System.in);
        int num = sc.nextInt();
        int ori = num;
        while(num !=0){
            int rem =num%10;
            sum = sum+ rem * rem *rem;
            num = num/10;
            
        }
        if(ori == sum){
            System.out.print("ArmStrong");
        }
        else{
            System.out.print("Not");
        }
        
    }
}
