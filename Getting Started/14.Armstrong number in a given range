import java.util.*;
public class Main{
    public static void main(String[] args){
        
        Scanner sc = new Scanner(System.in);
        int a= sc.nextInt();
        int b = sc.nextInt();
        
        
        for(int num=a ; num<=b ;num++){
            int temp= num;
            int sum =0;
           while(temp!=0){
            int digit =temp%10;
            sum = sum+ digit * digit *digit;
            temp = temp/10;
            
           }
        
        if(sum == num){
            System.out.print(num+" ");
        }
    
        }
        
        
    }
}
