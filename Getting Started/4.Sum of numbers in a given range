import java.util.*;
public class Main{
    public static void main(String[] args){
        int sum=0;
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int b = sc.nextInt();
        for(int i=a ;i<=b; i++){
            sum = sum+i;
        }
        System.out.print(sum);
    }
}
