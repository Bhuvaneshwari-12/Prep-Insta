import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int num = sc.nextInt();
	    int ori= num;
		int sum=0;
		for(int i=1; i<num ;i++){
		    if(num%i==0){
		        sum = sum+i;
		    }
		}
		if(sum == ori)
		System.out.print("Perfect no");
		else
		System.out.print("Not");
		
		
	}
}
