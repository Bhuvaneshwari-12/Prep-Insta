        if (isVowel(ch))
            System.out.println(ch + " is a vowel ");
        else
            System.out.println(ch + " is a consonant ");

        sc.close();
    }

    static boolean isVowel(char c) {
        return (c == 'A' || c == 'E' || c == 'I' || c == 'O' || c == 'U' ||
                c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u');
